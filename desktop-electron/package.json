{
  "name": "vants-hub",
  "productName": "VANTS",
  "version": "2.4.5",
  "description": "VANTS · Launcher oficial para Windows: tu cuenta, membresía, conexiones, partidos, bracket, líderes, en vivo y tu biblioteca de juegos con portadas — cada categoría en su cajón.",
  "author": "VANTS <contact@vants.app>",
  "homepage": "https://vants.vants.workers.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/feispla/Vants.git"
  },
  "main": "main.js",
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "gg.vants.hub",
    "productName": "VANTS",
    "copyright": "Copyright © 2026 VANTS",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": {
      "provider": "github",
      "owner": "feispla",
      "repo": "Vants",
      "releaseType": "draft"
    },
    "files": [
      "main.js",
      "preload.js",
      "telemetria.js",
      "seguridad.js",
      "renderer/**/*",
      "vants-bus-consumer.js"
    ],
    "win": {
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "VANTS-Setup-${version}.${ext}"
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "runAfterFinish": true,
      "upgradeCode": "4b3de2bc-5454-4d30-8866-f72998ee4077"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VANTS",
      "uninstallDisplayName": "VANTS ${version}"
    }
  }
}
