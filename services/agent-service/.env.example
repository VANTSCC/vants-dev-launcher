# ─────────────────────────────────────────────────────────────
# AGENTE VANTS (services/agent-service) — variables de entorno
# ─────────────────────────────────────────────────────────────

# Servidor (cargo: node server.js → :8082)
PORT=8082
ALLOW_ORIGIN=https://vants.vants.workers.dev
LOG_LEVEL=silent

# Token Bearer para /api/v1/* (vacío = sin auth, solo para pruebas locales)
AGENT_TOKEN=

# Memoria del agente en Neon (tablas agent_* de la migración 25).
# Sin esta variable el agente funciona en modo RAM (tests / degradado).
DATABASE_URL=

# Objetivos que el agente vigila
URLS_WEB=https://vants.vants.workers.dev
URLS_WORKER_FACEIT=https://vants-faceit-webhook.vants.workers.dev
# Opcional: si el matchmaking-service está publicado, pon su base aquí
URLS_MATCHMAKING=

# Acciones contra GitHub (el workflow agente.yml ya inyecta GITHUB_TOKEN;
# para correrlo fuera de Actions crea un PAT con permiso actions:write)
GITHUB_TOKEN=
GITHUB_REPOSITORY=feispla/vants

# ── Capa de IA (OPCIONAL) ─────────────────────────────────────
# Cualquier API compatible con OpenAI /chat/completions.
# Ejemplos de AGENT_LLM_URL:
#   GLM (Z.ai)    → https://open.bigmodel.cn/api/paas/v4
#   OpenAI        → https://api.openai.com/v1
#   Ollama local  → http://localhost:11434/v1
# Sin AGENT_LLM_KEY el agente usa su modo reglas (NLU local en español).
AGENT_LLM_URL=
AGENT_LLM_KEY=
AGENT_LLM_MODEL=glm-4-flash

# ─────────────────────────────────────────────────────────────
# Arranque:
#   node --env-file=.env server.js      (servidor de control)
#   node --env-file=.env cli.js ciclo   (vigilancia puntual)
# ─────────────────────────────────────────────────────────────
