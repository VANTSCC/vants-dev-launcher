# ─────────────────────────────────────────────────────────────
# AGENTE VANTS (services/agent-service) — variables de entorno
# ─────────────────────────────────────────────────────────────

# Servidor (cargo: node server.js → :8082)
PORT=8082
ALLOW_ORIGIN=https://vants.vants.workers.dev
LOG_LEVEL=silent

# Token Bearer para /api/v1/* (vacío = sin auth, solo para pruebas locales)
AGENT_TOKEN=

# Memoria del agente en Neon (tablas agent_* de la migración 25).
# Sin esta variable el agente funciona en modo RAM (tests / degradado).
DATABASE_URL=

# Objetivos que el agente vigila
URLS_WEB=https://vants.vants.workers.dev
URLS_WORKER_FACEIT=https://vants-faceit-webhook.vants.workers.dev
# Opcional: si el matchmaking-service está publicado, pon su base aquí
URLS_MATCHMAKING=

# Acciones contra GitHub (el workflow agente.yml ya inyecta GITHUB_TOKEN;
# para correrlo fuera de Actions crea un PAT con permiso actions:write)
GITHUB_TOKEN=
GITHUB_REPOSITORY=feispla/vants

# ── Capa de IA (OPCIONAL) ─────────────────────────────────────
# Cualquier API compatible con OpenAI /chat/completions CON tools
# (function calling). Con key configurada el agente es AGÉNTICO:
# el modelo (GLM) elige y encadena herramientas reales del núcleo
# (estado, informe, incidentes, resolver, ciclo, desplegar_web,
# migrar) y narra la respuesta final. Sin key → modo reglas
# (NLU local en español, 0 dependencias, siempre disponible).
# BASTA con AGENT_LLM_KEY: sin URL se usa la global de GLM
# (https://api.z.ai/api/paas/v4). Define AGENT_LLM_URL solo si tu
# key es de otro proveedor:
#   GLM (bigmodel.cn) → https://open.bigmodel.cn/api/paas/v4
#   OpenAI            → https://api.openai.com/v1
#   Ollama local      → http://localhost:11434/v1
# Modelos GLM recomendados: glm-5.3 (si tu cuenta tiene cuota) (máxima calidad) · glm-4.5-flash
# (rápido y económico, recomendado para vigilancia continua).
AGENT_LLM_URL=
AGENT_LLM_KEY=
AGENT_LLM_MODEL=glm-4.5-flash


# ── SANDBOX AGENT (migración 26) ──────────────────────────────
# Sin variables: los límites vienen por código. Referencia:
#   disco:   256 KB por fichero (agent_archivos en Neon)
#   exec:    timeout 10 s (máx 30 s) · salida máx 32 KB · allowlist
#            de comandos de lectura/diagnóstico (ver sandbox.js)
#   memoria: recuerdos de hasta 8 KB con expiración opcional
# ─────────────────────────────────────────────────────────────
# Arranque:
#   node --env-file=.env server.js      (servidor de control)
#   node --env-file=.env cli.js ciclo   (vigilancia puntual)
# ─────────────────────────────────────────────────────────────
