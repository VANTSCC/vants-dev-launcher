# Copia este archivo a .env y rellena los valores. NUNCA subas el .env real.
# Arranque con env file:  node --env-file=.env server.js
PORT=8081
ALLOW_ORIGIN=https://vants.vants.workers.dev
LOG_LEVEL=info

# Persistencia (Fase 4). Cadena postgres:// de Neon — SIN ella el servicio
# arranca en modo memoria (degradado: la cola vive solo en el proceso).
# Ejemplo: postgresql://usuario:password@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Auth0 (opcional: por defecto usa vants.eu.auth0.com sin audience)
# AUTH0_DOMAIN=vants.eu.auth0.com
# AUTH0_AUDIENCE=https://api.vants.gg
