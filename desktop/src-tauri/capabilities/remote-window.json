{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-window",
  "description": "Permite a la web de VANTS manejar la ventana sin bordes (minimizar, maximizar, cerrar, arrastrar)",
  "windows": ["main"],
  "remote": {
    "urls": ["https://feispla.github.io/*", "https://vantsinc.netlify.app/*"]
  },
  "permissions": [
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title"
  ]
}
