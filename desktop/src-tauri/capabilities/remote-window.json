{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-window",
  "description": "Permite a la web de VANTS (Workers/Pages/Netlify) manejar la ventana (minimizar, maximizar, cerrar, arrastrar) si se activa el modo sin bordes",
  "windows": ["main"],
  "remote": {
    "urls": ["https://vants.vants.workers.dev/*", "https://vants.geimerjhoan099.workers.dev/*", "https://feispla.github.io/*", "https://vantsinc.netlify.app/*"]
  },
  "permissions": [
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title"
  ]
}
