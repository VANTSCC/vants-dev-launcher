---
import Analytics from '@vercel/analytics/astro';
/* Tailwind v4 de la isla EXPLORAR (utilities sin preflight; arena.css sigue
   siendo el dueño del sistema base). Sin este import las clases de
   components/Explore.tsx no se compilan y el panel sale sin estilos. */
import '../styles/tw.css';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'VANTS GAMES — Arena competitiva de VALORANT y CS2',
  description = 'VANTS GAMES: arena competitiva de VALORANT y CS2. Partidos y resultados reales, ranking, calendario de torneos y rangos APEX. Entra con Google, Discord, GitHub, Kick o correo.',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href="https://vants.vants.workers.dev/">
  <meta property="og:title" content="VANTS GAMES — Arena competitiva">
  <meta property="og:url" content="https://vants.vants.workers.dev/">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Cpath d='M12 2H52L62 12V52L52 62H12L2 52V12Z' fill='%23191c22' stroke='%23ff0d2e' stroke-width='3'/%3E%3Cpath d='M9 14H23L34.5 44.5L32 52Z' fill='%23e8ecef'/%3E%3Cpath d='M55 14H41L32.4 37L42.2 37Z' fill='%23ff0d2e'/%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <!-- Google Fonts sin bloquear el primer pintado: se precarga la hoja y se
       activa al llegar (display=swap ya evita texto invisible). -->
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" rel="stylesheet"></noscript>
  <!-- lucide (355 KB) en defer: antes bloqueaba el primer pintado del hero.
       arena.js ya hace `if (window.lucide) lucide.createIcons()`, así que al
       cargar solo hay que pasar una vez por los <i data-lucide> ya pintados. -->
  <script is:inline src="https://unpkg.com/lucide@0.454.0/dist/umd/lucide.min.js" defer onload="if(window.lucide)lucide.createIcons()"></script>
  <link rel="stylesheet" href="./assets/css/arena.css?v=16">
  <link rel="stylesheet" href="./assets/css/vants-shop.css?v=1">
  <Analytics />
</head>
<body data-game="valorant">
  <slot />

  <!-- OVERLAYS -->
  <div class="ov" id="drawerOv"></div>
  <aside class="drawer" id="drawer"></aside>
  <div class="modal" id="modal"><div class="modal-bg" id="modalBg"></div><div class="modal-card" id="modalCard"></div></div>
  <div class="toasts" id="toasts"></div>

  <!-- Runtime arena (sin build: es la capa viva que ya corre en producción).
       defer: era el recurso que más bloqueaba el render en móvil (~1,6 s); los
       scripts de abajo también van en defer, así que el orden se conserva. -->
  <script is:inline src="./assets/js/arena.js?v=36" defer></script>
  <script is:inline>
    /* Apartados nuevos: Tienda × VegaStore + Equipo VANTS DE 5 + Patrocinios */
    (function () {
      var $ = function (s) { return document.querySelector(s) };
      var t = function (msg) { if (typeof window.toast === 'function') { window.toast(msg, 'ok') } else { console.log(msg) } };
      var shop = $('#shopNotifyBtn');
      if (shop) shop.addEventListener('click', function () { t('📌 Te avisamos cuando la tienda VANTS × VEGASTORE abra. Quedate atento en redes.') });
      var ident = $('#shopIdentBtn');
      if (ident) ident.addEventListener('click', function () { document.getElementById('pro').scrollIntoView({ behavior: 'smooth' }) });
      var sp = $('#sponsorsCtaBtn');
      if (sp) sp.addEventListener('click', function () { t('📨 Escribinos por Discord para recibir el kit de patrocinio de la Temporada 4.') });
    })();
  </script>
  <!-- Capa viva: Auth0 (login) + Neon (torneos reales) -->
  <script is:inline src="https://cdn.auth0.com/js/auth0-spa-js/2.1/auth0-spa-js.production.js" defer></script>
  <script is:inline src="./assets/js/auth0-config.js?v=16" defer></script>
  <script is:inline src="./assets/js/vants-supervisor.js?v=2" defer></script>
  <script is:inline src="./assets/js/arena-live.js?v=35" defer></script>
  <script is:inline src="./assets/js/vants-shop.js?v=1" defer></script>
  <script is:inline src="./assets/js/api-client.js?v=1" defer></script>
  <script is:inline src="./assets/js/session.js?v=1" defer></script>
  <script is:inline src="./assets/js/components.js?v=2" defer></script>
  <script is:inline src="./assets/js/menu-preview.js?v=10" defer></script>
  <script is:inline src="./assets/js/nav-movil.js?v=2" defer></script>
</body>
</html>
