---
// Nav principal con submenús estilo MYKD (hover/click despliega)
// + selector de juego. IDs requeridos por arena.js:
// proBadge, arenaLoginBtn, miCuentaBtn, gbNext
import { menu_data } from '../data/menu-data';
---
<header class="nav">
  <div class="wrap nav-in">
    <a href="#inicio" class="nav-logo">
      <svg class="mark"><use href="#vmark"></use></svg>
      <span class="wordmark"><b>VANT<em>S</em></b><small>GAMES</small></span>
    </a>
    <nav class="nav-links">
      {menu_data.map((item) => (
        <div class:list={['ni', { 'has-sub': item.sub_menu?.length }]}>
          <a href={item.link}>{item.title}{item.sub_menu?.length ? <span class="chev" aria-hidden="true">▾</span> : null}</a>
          {item.sub_menu?.length ? (
            <div class="dd" role="menu">
              {item.sub_menu.map((s) => (
                <a href={s.link} role="menuitem">{s.title}</a>
              ))}
            </div>
          ) : null}
        </div>
      ))}
    </nav>
    <div class="nav-right">
      <span class="pro-badge" id="proBadge"><i data-lucide="zap"></i>PRO</span>
      <a class="btn btn-ghost btn-sm" href="membresias.html"><i data-lucide="crown"></i>MEMBRESÍAS</a>
      <button class="btn btn-ghost btn-sm" id="arenaLoginBtn" hidden><i data-lucide="log-in"></i>ENTRAR</button>
      <button class="btn btn-ghost btn-sm" id="miCuentaBtn" hidden><i data-lucide="layout-dashboard"></i>MI CUENTA</button>
    </div>
  </div>
</header>

<!-- SELECTOR DE JUEGO -->
<div class="gamebar">
  <div class="wrap gamebar-in">
    <span class="gb-label"><i data-lucide="crosshair"></i>ELIGE TU ARENA</span>
    <div class="gswitch">
      <button class="gbtn on" data-game="valorant"><b>VALORANT</b><small>VANTS RATING 2.0</small></button>
      <button class="gbtn" data-game="cs2"><b>COUNTER-STRIKE 2</b><small>VANTS RATING 2.1</small></button>
    </div>
    <div class="gb-next" id="gbNext"><b>NEXT</b>PRÓXIMO EVENTO</div>
  </div>
</div>

<style>
  /* Submenús estilo MYKD: panel oscuro que despliega al hover/focus */
  .nav-links .ni {
    position: relative;
  }
  .nav-links .ni > a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .nav-links .chev {
    font-size: 9px;
    line-height: 1;
    opacity: 0.65;
    transition: transform 0.18s ease;
  }
  .nav-links .ni.has-sub > .dd {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translate(-50%, -6px);
    min-width: 236px;
    background: linear-gradient(180deg, #101218, #0c0d11);
    border: 1px solid #23262e;
    border-top: 2px solid var(--accent, #ff0d2e);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.55);
    padding: 7px;
    display: flex;
    flex-direction: column;
    gap: 1px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0.16s;
    z-index: 60;
  }
  .nav-links .ni.has-sub > .dd::before {
    content: '';
    position: absolute;
    inset: -10px 0 auto 0;
    height: 10px;
  }
  .nav-links .ni.has-sub:hover > .dd,
  .nav-links .ni.has-sub:focus-within > .dd {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }
  .nav-links .ni.has-sub:hover .chev {
    transform: rotate(180deg);
  }
  .nav-links .dd a {
    display: block;
    padding: 9px 12px;
    font: 700 10px/1.3 var(--sans, Archivo);
    letter-spacing: 0.1em;
    color: #b9c0c9;
    border-left: 2px solid transparent;
    transition: background 0.12s ease, color 0.12s ease, border-color 0.12s ease;
  }
  .nav-links .dd a:hover {
    background: rgba(255, 13, 46, 0.1);
    border-left-color: var(--accent, #ff0d2e);
    color: #fff;
  }
</style>
